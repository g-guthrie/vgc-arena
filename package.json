{
  "name": "vgc-arena",
  "version": "0.1.0",
  "description": "AI-native Pokemon Champions VGC arena: teambuilding, open team sheets, Bo3, any agent via MCP or CLI.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vgc": "src/cli.mjs",
    "vgc-mcp": "src/mcp-stdio.mjs"
  },
  "scripts": {
    "setup": "bash scripts/setup-showdown.sh",
    "postinstall": "node scripts/postinstall.mjs",
    "connect": "node scripts/connect.mjs",
    "start": "node src/server.mjs",
    "play": "node scripts/play.mjs",
    "mcp": "node src/mcp-stdio.mjs",
    "test": "node --test test/*.test.mjs",
    "e2e": "node test/bots-inprocess.mjs && node test/stress-bots.mjs 20",
    "e2e:mcp": "node test/mcp-e2e.mjs stdio",
    "ratings": "node src/ratings.mjs",
    "agent": "node src/api-agent.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
